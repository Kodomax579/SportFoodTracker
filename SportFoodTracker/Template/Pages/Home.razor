@page "/"
@using SportFoodTracker.Template.Pages
@using SportFoodTracker.Models.Sportsplan
@using SportFoodTracker.Service
@using SportFoodTracker.Models.enums
@using SportFoodTracker.Models.Training
@inject NavigationManager NavigationManager
@inject SportsplanService SportsplanService
@inject TrainingService TrainingService

<div class="container mt-3">
    <header class="text-center mb-4">
        <h2 class="fw-bold">@DateTime.Today.DayOfWeek.ToString()</h2>
        <p class="text-muted">Dein heutiger Status</p>
    </header>

    <div class="row mb-4 text-center">
        <div class="col-12">
            <div class="card shadow-sm border-primary">
                <div class="card-body">
                    <h5 class="card-title text-uppercase small text-muted">Verfügbare Kalorien</h5>
                  
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-6">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>Protein</h6>
                    @* <div class="fw-bold text-info">@RemainingProtein g</div> *@
                    <small>übrig</small>
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>Fett</h6>
                    @* <div class="fw-bold text-warning">@RemainingFat g</div> *@
                    <small>übrig</small>
                </div>
            </div>
        </div>
    </div>
    @if(sportsplan == null)
    {
        <p>dfas</p>
    }
    else
    {
        <div class="card shadow-sm mb-4">

            <!-- Header -->
            @foreach(var workout in sportsplan)
            {
                var todayPlan = GetTrainingModel(workout.WorkoutSessions);
                var isDone = todayPlan != null
                && trainingDoneToday.TryGetValue(todayPlan.Id, out var done)
                && done;

                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Todays Training</h5>

                    <button class="btn btn-sm @(isDone ? "btn-success" : "btn-outline-light")"
                            disabled="@isDone"
                            @onclick="() => StartTraining(workout.WorkoutSessions)">
                        @(isDone ? "✔ Training Done" : "Start")
                    </button>
                </div>

                <div class="card-body p-0">

                    @if (sportsplan == null)
                    {
                        <div class="alert alert-info m-3 text-center">
                            No trainingsplan found or active
                        </div>
                    }
                    else
                    {
                        var training = GetTrainingModel(workout.WorkoutSessions);
                        <div class="px-3 pt-3">
                            <h4 class="fw-bold mb-1">@workout.Description</h4>
                            <small class="text-muted">Heutiges Training</small>
                        </div>
                        <hr />
                        @if (training?.Exercise?.Any() == true)
                        {
                            <ul class="list-group list-group-flush mt-3">
                                @foreach (var exercise in training.Exercise)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="fw-medium">@exercise.Description</span>
                                        @switch (exercise.trainingParameter)
                                        {
                                            case TrainingParameter.Repetition:
                                                <span class="badge bg-secondary rounded-pill">@exercise.Sets x @exercise.Repetition x</span>
                                                break;
                                            case TrainingParameter.Meter:
                                                <span class="badge bg-secondary rounded-pill">@exercise.Sets x @exercise.Meter m</span>
                                                break;
                                            case TrainingParameter.Time:
                                                <span class="badge bg-secondary rounded-pill">@exercise.Sets x @exercise.Time</span>
                                                break;
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted text-center py-4 mb-0">
                                🛌 Restday
                            </p>
                        }
                    
                    }
                </div>
            }
        </div>
    }

</div>

@code {
    public List<TrainingProgramModel>? sportsplan;
    public TrainingModel? trainingModel;
    private Dictionary<int, bool> trainingDoneToday = new();

    /// <summary>
    /// initialize active sportplan and check if training is done today
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        sportsplan = await SportsplanService.GetActiveSportsplanAsync();

        if (sportsplan == null)
            return;

        foreach (var workout in sportsplan)
        {
            var todayPlan = GetTrainingModel(workout.WorkoutSessions);

            if (todayPlan != null)
            {
                trainingDoneToday[todayPlan.Id] =
                await TrainingService.IsTodayTrainingDoneAsync(todayPlan.Id);
            }
        }
    }

    /// <summary>
    /// Navigates to sportsplan overview
    /// </summary>
    private void NavigateToExerciseOverview()
    {
        NavigationManager.NavigateTo("/sportsplan-overview");
    }

    public WorkoutSessionModel GetTrainingModel(List<WorkoutSessionModel> trainingsplanModels)
    {
        return trainingsplanModels.FirstOrDefault(tp => tp.DayOfWeek.ToString() == DateTime.Now.DayOfWeek.ToString())!;
    }

    /// <summary>
    /// Navigate and start training
    /// </summary>
    public void StartTraining(List<WorkoutSessionModel> trainingsplanModels)
    {
        var todayPlan = GetTrainingModel(trainingsplanModels);

        if (todayPlan == null)
            return;

        trainingDoneToday[todayPlan.Id] = true;

        NavigationManager.NavigateTo($"/training/{todayPlan.Id}");
    }
}