@page "/training/history"
@using SportFoodTracker.Service
@using SportFoodTracker.Models.Training
@inject TrainingService TrainingService

<div class="container my-4">

    <div class="text-center mb-5">
        <h1 class="fw-bold">📊 Trainingshistorie</h1>
        <p class="text-muted">Deine abgeschlossenen Trainings</p>
    </div>

    @if (trainingList == null)
    {
        <div class="text-center text-muted">
            <div class="spinner-border"></div>
            <p class="mt-2">Lade Trainings…</p>
        </div>
    }
    else if (!trainingList.Any())
    {
        <div class="alert alert-info text-center">
            Noch keine Trainings vorhanden
        </div>
    }
    else
    {
        @foreach (var training in trainingList.OrderByDescending(t => t.Date))
        {
            <div class="card shadow-sm mb-4">

                <!-- Header -->
                <div class="card-header bg-dark text-white d-flex justify-content-between">
                    <strong>
                        🗓️ @training.Date.ToShortDateString()
                    </strong>
                    <span>
                        ⏱️ @training.time Minuten
                    </span>
                </div>

                <div class="card-body">

                    @foreach (var exerciseGroup in training.TrainingSets.GroupBy(r => r.Exercise))
                    {
                        <div class="mb-4">

                            <!-- Exercise title -->
                            <h5 class="fw-semibold mb-2">
                                @exerciseGroup.Key!.Description
                            </h5>

                            <!-- Sets table -->
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Set</th>
                                            <th>Repetitions</th>
                                            <th>Weight (kg)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (set, index) in exerciseGroup.Select((v, i) => (v, i)))
                                        {
                                            <tr>
                                                <td>@(index + 1)</td>
                                                <td>@set.Repetitions</td>
                                                <td>@set.Weight</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    }

                </div>
            </div>
        }
    }

</div>

@code {
    public List<TrainingModel>? trainingList;

    /// <summary>
    /// Initialize traininglist with all trainings
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        trainingList = await TrainingService.GetAllTrainingsAsync();
    }

}
