@page "/training/{Id:int?}"
@using SportFoodTracker.Service
@using SportFoodTracker.Models.Sportsplan
@using SportFoodTracker.Models.Training
@using SportFoodTracker.Models.enums
@using SportFoodTracker.Template.Component.Training
@inject SportsplanService sportsplanService
@inject TrainingService trainingService
@inject NavigationManager NavigationManager

<div class="container my-4">

    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">🏋️ Training</h1>
        <p class="text-muted">Todays Trainingsplan</p>
    </div>
    @if (trainingPlan == null)
    {
        <div class="text-center text-muted">
            <div class="spinner-border"></div>
            <p class="mt-2">Loading training plan…</p>
        </div>
    }
    else
    {
        @if (trainingPlan != null && Index < trainingPlan.Exercise.Count)
        {
            var nextExercise = GetNextExerciseFromIndex();
            if (nextExercise != null)
            {
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@nextExercise.Description</h4>
                </div>
                <TrainingExerciseComponent ExerciseModel="nextExercise" OnExerciseDone="ExerciseDone" RestTime="trainingPlan.pause"></TrainingExerciseComponent>
            }
        }
    }
    
    <button @onclick="EndTraining">
        End Training
    </button>

</div>


@code {
    [Parameter]
    public int Id { get; set; }
    public TrainingsplanModel? trainingPlan;
    public TrainingModel training = new();
    public DateTime startTraining;
    public DateTime endTraining;
    public int Index = 0;

    /// <summary>
    /// Initializes the component and loads today's training plan.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        trainingPlan = await sportsplanService.GetTrainingsplanByIdAsync(Id);

        startTraining = DateTime.Now;
    }

    public ExerciseModel? GetNextExerciseFromIndex()
    {
        if (trainingPlan == null || Index >= trainingPlan.Exercise.Count)
        {
            _ = EndTraining(); // Don't wait for response
            return null;
        }
        return trainingPlan.Exercise[Index];
    }


    public async Task IncrementIndex()
    {
        Index++;
        if (Index >= trainingPlan?.Exercise.Count)
        {
            await EndTraining();
            return;
        }
        await InvokeAsync(StateHasChanged);
    }

    public async Task ExerciseDone(TrainingModel trainingModel)
    {
        training = trainingModel;
        await IncrementIndex();
    }

    /// <summary>
    /// End the training and create saves the training data.
    /// </summary>
    /// <returns></returns>
    public async Task EndTraining()
    {
        endTraining = DateTime.Now;
        training.IsDone = true;
        training.time = (endTraining - startTraining).Minutes;
        training.Date = DateTime.Now.Date;
       
        await trainingService.SaveTrainingAsync(training);

        NavigationManager.NavigateTo("/");
    }
}
