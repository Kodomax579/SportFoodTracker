@page "/sportsplan/{id:int?}"
@using SportFoodTracker.Models.Sportsplan
@using SportFoodTracker.Models.enums
@using SportFoodTracker.Service
@using SportFoodTracker.Template.Component.Trainingsplan
@using System.Globalization;
@inject SportsplanService SportsplanService
@inject NavigationManager NavigationManager

@if (isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                @* Header Sektion *@
                <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
                    <h2 class="fw-bold text-dark mb-0">
                        <i class="bi bi-calendar-event me-2"></i>
                        @(id.HasValue ? "Edit plan" : "Create new plan")
                    </h2>
                    <button class="btn btn-primary shadow-sm" @onclick="OnSubmit">
                        <i class="bi bi-check-lg"></i> Save
                    </button>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body bg-light rounded">
                        <label class="form-label fw-semibold">plan name</label>
                        <input type="text" class="form-control form-control-lg border-0 shadow-sm"
                               placeholder="e.g. calisthenics plan" @bind="sportsplan!.Description" />
                        <label class="form-label fw-semibold">pause</label>
                        <input type="text" placeholder="mm:ss" @bind="DurationText" />
                    </div>
                </div>

                <div class="row g-4">
                    @{
                        // Logik-Mapping für die Anzeige
                        var daysToDisplay = id.HasValue
                        ? sportsplan.WorkoutSessions.Select(t => (t.DayOfWeek, t))!
                        : Enum.GetValues<Weekday>().Select(d => (d, (WorkoutSessionModel)null!));
                    }

                    @foreach (var (day, training) in daysToDisplay)
                    {
                        bool isActive = activeDay == day;

                        <div class="col-12 mb-3">
                            @* Auf 12 Spalten geändert für bessere Zeilenoptik *@
                            <div class="card border-0 shadow-sm @(isActive ? "ring-active" : "bg-light-subtle")"
                                 style="cursor: pointer; transition: all 0.3s ease;">

                                @* Header als Klick-Fläche *@
                                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-3"
                                     @onclick="() => ToggleDay(day)">
                                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center">
                                        <span class="badge @(isActive ? "bg-primary" : "bg-secondary") me-3">
                                            @day.ToString().Substring(0, 2)
                                        </span>
                                        @day
                                        <small class="text-muted ms-3 fw-normal" style="font-size: 0.8rem;">
                                            @(ExercisesPerDay[day].Count) Exercises
                                        </small>
                                    </h5>
                                    <i class="bi @(isActive ? "bi-chevron-up" : "bi-chevron-down") text-muted"></i>
                                </div>

                                @* Body nur zeigen, wenn dieser Tag aktiv ist *@
                                @if (isActive)
                                {
                                    <div class="card-body pt-0 animate-fade-in">
                                        <hr class="mt-0 opacity-10" />
                                        @if (ExercisesPerDay.ContainsKey(day))
                                        {
                                            @foreach (var exercise in ExercisesPerDay[day])
                                            {
                                                <div class="exercise-row position-relative p-3 mb-3 rounded-3 border shadow-sm bg-white">
                                                    @if(!exercise.IsCreated)
                                                    {
                                                        <TrainingInputDetailComponent ExerciseData="(args) => OnSaveExercise(args, day)" exercise="exercise"></TrainingInputDetailComponent>
                                                    }
                                                    else
                                                    {
                                                        <TrainingShowInputComponent exercise="exercise" Onclick="() => OnEditTrainingDetail(exercise)"></TrainingShowInputComponent>
                                                    }
                                                    <button class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2"
                                                            @onclick="() => OnRemoveExercise(day, exercise)"
                                                            title="Delete exercise">
                                                        <i class="bi bi-trash3-fill">X</i>
                                                    </button>
                                                </div>
                                            }
                                        }
                                        <button class="btn btn-outline-primary w-100 py-2 border-dashed mt-2"
                                                @onclick="() => OnAddExercise(day)">
                                            <i class="bi bi-plus-lg me-2"></i> Add exercise @day 
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .ring-active {
        border-left: 5px solid #0d6efd !important;
        background-color: white !important;
    }

    .border-dashed {
        border-style: dashed !important;
    }

    .animate-fade-in {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .exercise-row:hover {
        background-color: #fbfbfb !important;
        border-color: #dee2e6 !important;
    }

    .exercise-row .btn-danger {
        transition: transform 0.2s;
    }

    .exercise-row .btn-danger:hover {
        transform: scale(1.2);
    }

</style>

@code {
    [Parameter]
    public int? id{ get; set; }
    private Weekday? activeDay;
    public TimeOnly pause;
    public TrainingProgramModel? sportsplan;
    public Dictionary<Weekday,int> IndexForEveryWeekday = new Dictionary<Weekday, int>()
    {
        {Weekday.Monday, 0},
        {Weekday.Tuesday, 0},
        {Weekday.Wednesday, 0},
        {Weekday.Thursday, 0},
        {Weekday.Friday, 0 },
        {Weekday.Saturday, 0},
        {Weekday.Sunday, 0}
    };


    bool IsEditMode => id.HasValue;
    public bool isLoading = true;
    private string DurationText = "01:00";

    private TimeSpan Duration =>
        TimeSpan.ParseExact(DurationText, @"mm\:ss", CultureInfo.InvariantCulture);



    public Dictionary<Weekday, List<ExerciseEntryModel>> ExercisesPerDay = Enum.GetValues<Weekday>()
    .ToDictionary(day => day, day => new List<ExerciseEntryModel>());
    /// <summary>
    /// Initializes the component by loading the sports plan if an ID is provided.
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        if(id.HasValue)
        {
            sportsplan = await SportsplanService.GetWorkoutByIdAsync(id.Value);

            MapTrainingsplanToExervicesPerDay();
        }
        else
        {
            sportsplan = new TrainingProgramModel();
        }
        isLoading = false;
    }

    /// <summary>
    /// Add a new exercise to the specified weekday.
    /// </summary>
    /// <param name="weekday"></param>
    public void OnAddExercise(Weekday weekday)
    {
        ExercisesPerDay[weekday].Add(new ExerciseEntryModel() { InternalId = IndexForEveryWeekday[weekday] });
        IndexForEveryWeekday[weekday]++;
    }

    public void OnSaveExercise(ExerciseEntryModel exerciseModel, Weekday day)
    {
        ExercisesPerDay[day][exerciseModel.InternalId] = exerciseModel;
    }

    /// <summary>
    /// Create or Update sportsplan 
    /// </summary>
    /// <returns></returns>
    public async Task OnSubmit()
    {
        if (IsEditMode)
        {
            if (sportsplan == null)
            {
                return;
            }
            UpdateExistingSportsplan();
            await SportsplanService.UpdateSportsplan(sportsplan);
        }
        else
        {
            if (sportsplan == null)
            {
                return;
            }
            BuildNewSportsplan();
            await SportsplanService.CreateNewSportsplan(sportsplan);
        }

        NavigationManager.NavigateTo("/sportsplan-overview");
    }

    /// <summary>
    /// Build new sportsplan object
    /// </summary>
    private void BuildNewSportsplan()
    {
        if (sportsplan == null)
            return;

        sportsplan.WorkoutSessions = new List<WorkoutSessionModel>();

        var pauseTime = TimeOnly.FromTimeSpan(Duration);

        foreach (Weekday day in Enum.GetValues<Weekday>())
        {
            sportsplan.WorkoutSessions.Add(new WorkoutSessionModel
            {
                pause = pauseTime,
                DayOfWeek = day,
                Exercise = ExercisesPerDay[day]
                    .Select(e => new ExerciseEntryModel
                    {
                        Description = e.Description,
                        Repetition = e.Repetition,
                        Sets = e.Sets,
                        Meter = e.Meter,
                        Time = e.Time,
                        IsCreated = e.IsCreated,
                        trainingParameter = e.trainingParameter,
                        InternalId = e.InternalId
                    })
                    .ToList()
            });
        }
    }


    /// <summary>
    /// Update existing sportplan object
    /// </summary>
    private void UpdateExistingSportsplan()
    {
        if (sportsplan == null)
        {
            return;
        }
        foreach (var training in sportsplan.WorkoutSessions)
        {
            if (!ExercisesPerDay.ContainsKey(training.DayOfWeek))
                continue;

            training.Exercise = ExercisesPerDay[training.DayOfWeek];
        }
    }

    /// <summary>
    /// set or unset active day
    /// </summary>
    /// <param name="day"></param>
    private void ToggleDay(Weekday day)
    {
        if (activeDay == day)
            activeDay = null;
        else
            activeDay = day;
    }

    /// <summary>
    /// Remove exercise from specified day
    /// </summary>
    /// <param name="day"></param>
    /// <param name="exercise"></param>
    private void OnRemoveExercise(Weekday day, ExerciseEntryModel exercise)
    {
        if (ExercisesPerDay.ContainsKey(day))
        {
            ExercisesPerDay[day].Remove(exercise);
        }
        IndexForEveryWeekday[day]--;
    }

    /// <summary>
    /// Set IsCreated to false to open the trainingInputDetailComponent
    /// </summary>
    public void OnEditTrainingDetail(ExerciseEntryModel exercise)
    {
        exercise.IsCreated = false;
    }

    /// <summary>
    /// map trainingsplan to exervices per day
    /// </summary>
    private void MapTrainingsplanToExervicesPerDay()
    {
        if (sportsplan == null)
        {
            return;
        }
        foreach(var day in Enum.GetValues<Weekday>())
        {
            ExercisesPerDay[day].Clear();
        }

        if(sportsplan.WorkoutSessions == null)
        {
            return;
        }

        foreach (var training in sportsplan.WorkoutSessions)
        {
            if (!ExercisesPerDay.ContainsKey(training.DayOfWeek))
                continue;

            if (training.Exercise == null)
                continue;

            IndexForEveryWeekday[training.DayOfWeek] = training.Exercise.Count;

            ExercisesPerDay[training.DayOfWeek] = training.Exercise
                .Select(e => new ExerciseEntryModel
                {
                    Id = e.Id,
                    Description = e.Description,
                    Repetition = e.Repetition,
                    Sets = e.Sets,
                    WorkoutSessionId = e.WorkoutSessionId,
                    IsCreated = e.IsCreated,
                    trainingParameter = e.trainingParameter,
                    Time = e.Time,
                    Meter = e.Meter
                })
                .ToList();
        }
    }
}
