@page "/sportsplan-overview"
@using SportFoodTracker.Models.Sportsplan
@using SportFoodTracker.Models.Sportsplan.enums
@using SportFoodTracker.Service
@inject SportsplanService SportsplanService
@inject NavigationManager NavigationManager

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Today</h2>
            <small class="text-muted">
                @GetWeekdayFromSystemDay(dateTime.DayOfWeek)
            </small>
        </div>

        <button class="btn btn-primary"
                @onclick="onAddSportsplan">
            + Sportsplan
        </button>
    </div>

    @if (sportsplans == null)
    {
        <div class="text-center text-muted">
            <div class="spinner-border"></div>
            <p class="mt-2">Load Sportsplans...</p>
        </div>
    }
    else if (!sportsplans.Any())
    {
        <div class="alert alert-info">
            No Sportsplans found. Please add a new Sportsplan.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var sportsplan in sportsplans)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 sportsplan-card">
                        <div class="card-body d-flex flex-column">

                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-semibold">@sportsplan.Description</h5>
                                <span class="badge @(sportsplan.IsActive ? "bg-success" : "bg-secondary")">
                                    @(sportsplan.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>

                            <!-- Buttons -->
                            <div class="btn-group mb-3" role="group">
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => onEditSportsplan(sportsplan.Id)">
                                    Edit
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => onDeleteSportsplan(sportsplan)">
                                    Delete
                                </button>
                                <button class="btn btn-outline-success btn-sm" @onclick="() => onIsActive(sportsplan)">
                                    Toggle Active
                                </button>
                            </div>

                            <hr />

                            <!-- Today's Training -->
                            @{
                                var today = GetWeekdayFromSystemDay(dateTime.DayOfWeek);
                                var todayTraining = sportsplan.Trainingsplan?.FirstOrDefault(t => t.DayOfWeek == today);
                            }

                            @if (todayTraining?.Exercise?.Any() == true)
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var exercise in todayTraining.Exercise)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1 border-0">
                                            <span>@exercise.Description</span>
                                            <span class="badge bg-secondary rounded-pill">@exercise.Repetition ×</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted small mb-0 text-center">Restday</p>
                            }

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    public List<SportsplanModel> sportsplans;
    public DateTime dateTime;

    protected override async Task OnInitializedAsync()
    {
        sportsplans = await SportsplanService.GetAllAsync();
        dateTime = DateTime.Now;
    }

    public void onAddSportsplan()
    {
        NavigationManager.NavigateTo("/sportsplan");
    }
    public void onEditSportsplan(int id)
    {
        NavigationManager.NavigateTo($"/sportsplan/{id}");
    }
    public async Task onDeleteSportsplan(SportsplanModel sportsplan)
    {
        await SportsplanService.DeleteSportsplan(sportsplan);
        sportsplans = await SportsplanService.GetAllAsync();
        StateHasChanged();
    }
    public async Task onIsActive(SportsplanModel sportsplan)
    {
        sportsplan.IsActive = !sportsplan.IsActive;
        await SportsplanService.UpdateSportsplan(sportsplan);
    }

    Weekday GetWeekdayFromSystemDay(DayOfWeek day)
      => day == DayOfWeek.Sunday ? Weekday.Sunday : (Weekday)((int)day - 1);
}
